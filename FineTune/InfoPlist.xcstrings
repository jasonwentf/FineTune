{
  "sourceLanguage": "en",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune needs access to control volume levels for individual applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 需要音频录制权限来单独控制各应用的音量。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune uses Bluetooth to connect paired audio devices from the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 使用 Bluetooth 从菜单栏连接已配对的音频设备。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune needs microphone access to capture audio from apps using input-capable devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 需要麦克风权限来捕获使用输入设备的应用音频。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
